{
  "name": "audio-quality-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cartesia": "TTS=cartesia-tts TTS_MODEL=sonic-3.6 STT=cartesia-stt STT_MODEL=ink-2 LANG_CODE=en tsx scripts/roundtrip.ts",
    "cartesia:voices": "tsx scripts/cartesia-voices.ts",
    "catalog:selftest": "tsx scripts/catalog-selftest.ts",
    "dev": "tsx watch src/index.ts",
    "elevenlabs": "TTS=elevenlabs-tts TTS_MODEL=eleven_flash_v2_5 STT=cartesia-stt STT_MODEL=ink-2 LANG_CODE=en tsx scripts/roundtrip.ts",
    "elevenlabs:buffer": "tsx scripts/elevenlabs-buffer.ts",
    "elevenlabs:selftest": "tsx scripts/elevenlabs-selftest.ts",
    "gemini:live": "tsx scripts/gemini-live.ts",
    "gemini:selftest": "tsx scripts/gemini-selftest.ts",
    "gemini:speech": "TTS=gemini-tts TTS_MODEL=gemini-3.1-flash-tts-preview STT=gemini-stt STT_MODEL=gemini-3.5-transcribe-live LANG_CODE=en-US tsx scripts/roundtrip.ts",
    "gemini:speech:selftest": "tsx scripts/gemini-speech-selftest.ts",
    "models": "tsx scripts/list-models.ts",
    "murf:probe": "tsx scripts/murf-probe.ts",
    "murf:selftest": "tsx scripts/murf-selftest.ts",
    "murf:voices": "tsx scripts/murf-voices.ts",
    "openai:llm:selftest": "tsx scripts/openai-llm-selftest.ts",
    "openai:realtime:selftest": "tsx scripts/openai-realtime-selftest.ts",
    "realtime:probe": "tsx scripts/realtime-probe.ts",
    "recorder:selftest": "tsx scripts/recorder-selftest.ts",
    "roundtrip": "tsx scripts/roundtrip.ts",
    "sarvam": "TTS=sarvam-tts TTS_MODEL=bulbul:v3 STT=sarvam-stt STT_MODEL=saaras:v3-realtime@fast VOICE=shubh LANG_CODE=en-IN tsx scripts/roundtrip.ts",
    "smoke": "node scripts/smoke.mjs pipeline && node scripts/smoke.mjs realtime",
    "start": "tsx src/index.ts",
    "auth:selftest": "tsx scripts/auth-selftest.ts",
    "turn:selftest": "tsx scripts/turn-selftest.ts",
    "typecheck": "tsc --noEmit",
    "usage:selftest": "tsx scripts/usage-selftest.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
