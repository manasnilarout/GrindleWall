PORT=8787
# HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
# LOG_AUDIO=1
# Production all-in-one image: directory of the Vite build (index.html + assets).
# Unset for local `npm run dev` — Vite serves the UI on :5173.
# STATIC_DIR=/app/ui

# --- naive login (both required to turn the gate on) ---
# Username is always admin@magickvoice.com. The HMAC secret is served to the
# login page so it can HMAC the password before POST /api/auth/login; the
# backend recomputes the same digest of AUTH_PASSWORD and compares.
# A password shorter than 12 characters is still scrubbed from errors, but
# pick something longer anyway — this is the only secret on the gate.
# AUTH_PASSWORD=
# AUTH_HMAC_SECRET=
# How long a session lasts after login. Default 3, capped at 24.
# AUTH_SESSION_HOURS=3

# --- realtime (speech-to-speech) ---
OPENAI_API_KEY=
# Gemini LLM (google-llm) and Gemini Live realtime
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Sarvam (Saaras STT + Bulbul TTS) ---
SARVAM_API_KEY=

# --- STT ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- TTS ---
MURF_API_KEY=
CARTESIA_API_KEY=

# ---- cost estimation (all optional) ----------------------------------------
# Where completed conversations are filed. Default: backend/data/sessions
# SESSION_DIR=data/sessions
# Cartesia meters in credits; the dollar value depends on your plan.
# Pro $5/100K = 0.00005 (default), Startup $49/1.25M, Scale $299/8M.
# CARTESIA_USD_PER_CREDIT=0.00005
# Sarvam publishes in rupees. This is an assumed rate, not a feed: ~₹94.43 per $1
# as of 2026-09-05, reported in every session summary. Default 1/94.43.
# USD_PER_INR=0.01059
# Keep only the newest N conversations (oldest are deleted on write).
# Unset or 0 keeps everything, which is the default.
# SESSION_MAX_RECORDS=0

# Conversations are recorded to data/sessions/<id>.wav — one stereo file, left
# channel the mic, right channel the assistant. Recording starts when the mic is
# opened and ends with the conversation, so a typed-only conversation has no
# recording at all. Set to 0 to turn it off.
# SESSION_AUDIO=1
# Cap on a single recording. Stereo PCM16 @ 24kHz is ~5.8 MB per recorded
# minute, so this is what stops a forgotten tab filling the disk. Hitting it
# finalizes the recording rather than discarding it. Default 60.
# SESSION_AUDIO_MAX_MINUTES=60
