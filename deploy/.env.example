# Copy to deploy/.env (that file is gitignored) and fill only the keys you use.
# Compose `env_file: .env` requires this file to exist. Empty values are fine —
# mock providers stay registered and the bench runs without vendor credentials.
# A real provider without its key shows as not ready in the UI rather than
# crashing the process.
#
# Compose reads this file and also applies CORS_ORIGINS / HTTP_PORT from it.

# Host port the UI is published on (compose maps this → container 80 or 8080).
# Set this to 80 on a public host. The FIRST certificate is issued while only
# this file's stack is running, and ACME HTTP-01 reaches it on port 80 — this
# is the only thing that publishes it at that point. (The TLS overlay then
# publishes 80 and 443 itself, so afterwards this only decides whether a
# redundant extra host port also points at the UI.)
HTTP_PORT=8080

# Public hostname for the TLS overlay (docker-compose.https.yml): nginx's
# server_name, the certificate path, and the default CORS origin. Required by
# the overlay, unused by the plain-HTTP stack.
PUBLIC_DOMAIN=grindelwald.magickvoice.app

# Origins allowed to call the API cross-origin. Same-origin through the
# reverse proxy does not need CORS, but set this if something calls the API
# from another origin. Comma-separated. Left unset it follows the stack:
# http://localhost:8080 plain, https://$PUBLIC_DOMAIN under the
# TLS overlay — so uncomment it only to add an origin.
# CORS_ORIGINS=http://localhost:8080

# ---- backend listen (compose overrides PORT / HOST / STATIC_DIR)
# Do not set PORT=8787 here if you `docker run` the all-in-one image on 8080 —
# that file is applied as-is, unlike compose `environment:` which pins PORT.
# HOST=0.0.0.0
# PORT=8080
# STATIC_DIR=/app/ui
# SESSION_DIR=/data/sessions

# LOG_AUDIO=1

# --- admin password login (both required to turn it on) ---
# Username is always admin@magickvoice.com. Unset, the bench stays open.
# Sessions live in the process — a container restart signs everyone out.
# AUTH_PASSWORD=
# AUTH_HMAC_SECRET=
# AUTH_SESSION_HOURS=3

# --- Google sign-in (Firebase Auth) ---
# FIREBASE_PROJECT_ID and FIREBASE_API_KEY together turn it on (and turn the
# gate on, even without AUTH_PASSWORD). Both are in the Firebase console's
# project settings, on the registered web app's config. The API key is served
# to every visitor (as all Firebase web apps do) — so RESTRICT it in the Google
# Cloud console to the Firebase Auth APIs; unrestricted, it works against every
# API in its project, Gemini included if that is the same project.
# In Firebase Authentication: enable the Google provider, and add the site's
# hostname to the authorized domains.
# Never used against a real Firebase project yet — see README.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=          # default <project id>.firebaseapp.com
# FIREBASE_APP_ID=               # optional
# Email domains whose Google accounts may sign in. Pinned: the Access page
# cannot remove these. Unset = magickvoice.com; set but blank = none pinned. Admins add more domains / single addresses there; those
# persist to SESSION_DIR/.auth/allowlist.json (override: AUTH_ALLOWLIST_FILE).
# AUTH_ALLOWED_DOMAINS=magickvoice.com
# Google accounts that sign in as admin (may edit the allowlist), admitted
# whatever the allowlist says. The password login is always admin.
# AUTH_ADMIN_EMAILS=

# --- realtime (speech-to-speech) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Sarvam (Saaras STT + Bulbul TTS) ---
SARVAM_API_KEY=

# --- STT ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- TTS ---
MURF_API_KEY=
CARTESIA_API_KEY=

# ---- cost estimation (all optional) ----------------------------------------
# CARTESIA_USD_PER_CREDIT=0.00005
# Default is 1/94.43 (~0.01059). Uncomment only to override.
# USD_PER_INR=0.01059
# SESSION_MAX_RECORDS=0
# SESSION_AUDIO=1
# SESSION_AUDIO_MAX_MINUTES=60
