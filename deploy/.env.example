# Copy to deploy/.env (that file is gitignored) and fill only the keys you use.
# Compose `env_file: .env` requires this file to exist. Empty values are fine —
# mock providers stay registered and the bench runs without vendor credentials.
# A real provider without its key shows as not ready in the UI rather than
# crashing the process.
#
# Compose reads this file and also applies CORS_ORIGINS / HTTP_PORT from it.

# Host port the UI is published on (compose maps this → container 80 or 8080).
# Set this to 80 on a public host. The FIRST certificate is issued while only
# this file's stack is running, and ACME HTTP-01 reaches it on port 80 — this
# is the only thing that publishes it at that point. (The TLS overlay then
# publishes 80 and 443 itself, so afterwards this only decides whether a
# redundant extra host port also points at the UI.)
HTTP_PORT=8080

# Origins allowed to call the API cross-origin. Same-origin through the
# reverse proxy does not need CORS, but set this if something calls the API
# from another origin. Comma-separated. Left unset it follows the stack:
# http://localhost:8080 plain, https://grindelwald.magickvoice.com under the
# TLS overlay — so uncomment it only to add an origin.
# CORS_ORIGINS=http://localhost:8080

# ---- backend listen (compose overrides PORT / HOST / STATIC_DIR)
# Do not set PORT=8787 here if you `docker run` the all-in-one image on 8080 —
# that file is applied as-is, unlike compose `environment:` which pins PORT.
# HOST=0.0.0.0
# PORT=8080
# STATIC_DIR=/app/ui
# SESSION_DIR=/data/sessions

# LOG_AUDIO=1

# --- naive login (both required to turn the gate on) ---
# Username is always admin@magickvoice.com. Unset, the bench stays open.
# Sessions live in the process — a container restart signs everyone out.
# AUTH_PASSWORD=
# AUTH_HMAC_SECRET=
# AUTH_SESSION_HOURS=3

# --- realtime (speech-to-speech) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Sarvam (Saaras STT + Bulbul TTS) ---
SARVAM_API_KEY=

# --- STT ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- TTS ---
MURF_API_KEY=
CARTESIA_API_KEY=

# ---- cost estimation (all optional) ----------------------------------------
# CARTESIA_USD_PER_CREDIT=0.00005
# Default is 1/94.43 (~0.01059). Uncomment only to override.
# USD_PER_INR=0.01059
# SESSION_MAX_RECORDS=0
# SESSION_AUDIO=1
# SESSION_AUDIO_MAX_MINUTES=60
