# Copy to deploy/.env (that file is gitignored) and fill only the keys you use.
# Empty values are fine — mock providers stay registered and the bench runs
# without vendor credentials. A real provider without its key shows as not
# ready in the UI rather than crashing the process.
#
# Compose reads this file and also applies CORS_ORIGINS / HTTP_PORT from it.

# Host port the UI is published on (compose maps this → container 80 or 8080).
HTTP_PORT=8080

# Origins allowed to call the API cross-origin. Same-origin through the
# reverse proxy does not need CORS, but set this to the public URL if you
# ever expose the backend port directly. Comma-separated.
CORS_ORIGINS=http://localhost:8080

# ---- backend listen (compose overrides PORT; listed for the all-in-one image)
# PORT=8080
# STATIC_DIR=/app/ui
# SESSION_DIR=/data/sessions

# LOG_AUDIO=1

# --- realtime (speech-to-speech) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Sarvam (Saaras STT + Bulbul TTS) ---
SARVAM_API_KEY=

# --- STT ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- TTS ---
MURF_API_KEY=
CARTESIA_API_KEY=

# ---- cost estimation (all optional) ----------------------------------------
# CARTESIA_USD_PER_CREDIT=0.00005
# USD_PER_INR=0.0113
# SESSION_MAX_RECORDS=0
# SESSION_AUDIO=1
# SESSION_AUDIO_MAX_MINUTES=60
