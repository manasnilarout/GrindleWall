{
  "name": "audio-quality-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-protocol": "cp ../backend/src/shared/protocol.ts src/lib/protocol.ts",
    "sync-voice-stack-spec": "node scripts/sync-voice-stack-spec.mjs",
    "render-check": "vite build --ssr scripts/render-check.tsx --outDir dist-check --logLevel error && node dist-check/render-check.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:components": "vitest run test/components",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
